# ============================================
#  SUKUNA MD — Environment Variables
# ============================================

# ===== Required =====
# Owner = main admin of the bot (country code, no +)
OWNER_NUMBER=2349127857212
# Pair  = WhatsApp number to be paired on boot
PAIR_NUMBER=2349127857212

# ===== Optional: paste a base64 SESSION_ID to skip pairing =====
# If set, creds.json is restored into sessions/<PAIR_NUMBER>/ on boot.
# Accepts raw JSON, base64 JSON, or "SUKUNA~<base64>" forms.
SESSION_ID=

# ===== Optional API keys =====
OPENAI_API_KEY=
WEATHER_API_KEY=
